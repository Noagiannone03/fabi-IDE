{
  "name": "fabi-swarm",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.1.0",
  "description": "Fabi Swarm \u2014 provider d'inf\u00e9rence LLM P2P (Parallax) branch\u00e9 dans Theia AI",
  "author": "Noa Giannone",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "resources"
  ],
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/openai": "1.6.2",
    "@theia/ai-chat": "1.72.2",
    "@theia/ai-chat-ui": "1.72.2",
    "@theia/ai-core": "1.72.2",
    "@theia/ai-ide": "1.72.2",
    "@theia/ai-openai": "1.72.2",
    "@theia/core": "1.72.2",
    "@theia/editor": "1.72.2",
    "@theia/filesystem": "1.72.2",
    "@theia/navigator": "1.72.2",
    "@theia/scm": "1.72.2",
    "@theia/terminal": "1.72.2",
    "@theia/workspace": "1.72.2",
    "d3-path": "3.1.0",
    "deepagents": "1.14.2",
    "electron-updater": "6.8.9",
    "eventsource-parser": "^3.1.0",
    "langchain": "1.5.16",
    "lucide-react": "^1.18.0",
    "mermaid": "11",
    "opencode-ai": "1.3.13",
    "systeminformation": "^5.23.5",
    "zod": "4.2.1",
    "typescript": "~5.4.5",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/d3-path": "3.1.1",
    "@types/node": "22.19.21",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc && node ../tools/build-assist-tools.mjs",
    "test": "yarn build && node --test test/*.test.js",
    "watch": "tsc -w",
    "test:assist": "yarn build && node --test test/assist.test.js test/assist-runtime.test.js"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/fabi-swarm-frontend-module"
    },
    {
      "backend": "lib/node/fabi-swarm-backend-module"
    },
    {
      "electronMain": "lib/electron-main/fabi-electron-main-module"
    }
  ]
}
