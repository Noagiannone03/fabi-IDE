{
  "name": "fabi-spaces",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.1.0",
  "description": "Fabi Spaces — plusieurs bureaux de travail (workspaces) dans une seule fenêtre, façon Arc Browser",
  "author": "Noa Giannone",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "resources"
  ],
  "dependencies": {
    "@theia/core": "1.72.2",
    "@theia/filesystem": "1.72.2",
    "@theia/remote": "1.72.2",
    "@theia/workspace": "1.72.2",
    "fabi-swarm": "0.1.0",
    "jsonc-parser": "^3.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "electron": "39.8.7",
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "test": "yarn run build && node --test test/*.test.js",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "electronMain": "lib/electron-main/fabi-spaces-electron-main-module",
      "frontendElectron": "lib/electron-browser/remote-space-module",
      "backendElectron": "lib/electron-node/remote-space-backend-module"
    }
  ]
}
